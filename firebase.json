{
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "firestore": { "port": 8080 },
    "pubsub": { "port": 8088 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
